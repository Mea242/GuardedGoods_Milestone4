@page
@model GuardedGoods_Milestone4.Pages.cartPages.IndexModel

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-page="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Cart[0].user_ID)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Cart[0].product_ID)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Cart[0].quantity)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Cart[0].cart_total)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.Cart) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.user_ID)
            </td>
            <td>
                @Html.DisplayFor(model => item.product_ID)
            </td>
            <td>
                @Html.DisplayFor(model => item.quantity)
            </td>
            <td>
                @Html.DisplayFor(model => item.cart_total)
            </td>
            <td>
                <a asp-page="./Edit" asp-route-id="@item.cart_ID">Edit</a> |
                <a asp-page="./Details" asp-route-id="@item.cart_ID">Details</a> |
                <a asp-page="./Delete" asp-route-id="@item.cart_ID">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
